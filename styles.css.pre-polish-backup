:root {
  --ink: #eef9f0;
  --muted: #9ab4a0;
  --line: rgba(191, 229, 199, 0.16);
  --canvas: #06120d;
  --canvas-raised: #0b1d14;
  --card: #0e2519;
  --accent: #b8ff6c;
  --accent-dark: #173610;
  --orange: #ffa665;
  --display: Georgia, "Times New Roman", serif;
  --body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; background: var(--canvas); color: var(--ink); font-family: var(--body);
  line-height: 1.55; overflow-x: hidden;
  background-image: radial-gradient(circle at 82% -5%, rgba(74, 140, 75, .27), transparent 30rem);
}
a { color: inherit; text-underline-offset: 3px; }
button { font: inherit; }
.skip-link { position: fixed; left: .75rem; top: -5rem; z-index: 20; background: var(--accent); color: #06120d; padding: .6rem .9rem; border-radius: .35rem; }
.skip-link:focus { top: .75rem; }
.site-header {
  position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; padding: 1.15rem 0;
  background: rgba(6, 18, 13, .82); backdrop-filter: blur(16px);
}
.brand { display: inline-flex; align-items: center; gap: .55rem; color: var(--ink); text-decoration: none; font-size: 1.06rem; letter-spacing: -.02em; white-space: nowrap; }
.brand strong { color: var(--accent); }
.site-nav { display: flex; gap: 1.4rem; align-items: center; font-size: .9rem; color: var(--muted); }
.site-nav a { text-decoration: none; }
.site-nav a:hover, .site-nav a:focus-visible { color: var(--accent); }
.menu-toggle { display: none; border: 0; background: transparent; color: var(--ink); padding: .5rem; }
.menu-toggle span:not(.sr-only) { display: block; width: 1.45rem; height: 2px; background: currentColor; margin: .25rem; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.section-shell { width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; }
.hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 4.5rem; min-height: 650px; align-items: center; padding: 5rem 0 4.5rem; }
.eyebrow { margin: 0 0 .8rem; color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
h1, h2 { font-family: var(--display); font-weight: 400; letter-spacing: -.04em; line-height: .98; margin: 0; }
h1 { max-width: 760px; font-size: clamp(3rem, 6vw, 5.8rem); }
h1 em { color: var(--accent); font-style: italic; }
h2 { font-size: clamp(2.2rem, 4vw, 3.55rem); max-width: 700px; }
.lede { max-width: 630px; margin: 1.6rem 0 2rem; color: var(--muted); font-size: clamp(1.04rem, 1.8vw, 1.22rem); }
.hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; }
.button { display: inline-flex; justify-content: center; align-items: center; gap: .55rem; min-height: 2.9rem; padding: .7rem 1rem; border: 1px solid transparent; border-radius: .4rem; font-weight: 700; text-decoration: none; cursor: pointer; }
.button-primary { background: var(--accent); color: #0a1b10; }
.button-primary:hover, .button-primary:focus-visible { background: #d1ff99; }
.button-secondary { border-color: var(--line); color: var(--ink); }
.button-secondary:hover, .button-secondary:focus-visible { border-color: var(--accent); }
.microcopy { margin: 1.1rem 0 0; color: var(--muted); font-size: .8rem; }
.hero-panel { border: 1px solid var(--line); background: linear-gradient(145deg, rgba(17,50,32,.9), rgba(7,21,14,.9)); border-radius: .75rem; box-shadow: 18px 22px 0 rgba(184,255,108,.08); overflow: hidden; }
.panel-top { padding: .85rem 1rem; border-bottom: 1px solid var(--line); color: var(--muted); font: .76rem ui-monospace, SFMono-Regular, Menlo, monospace; }
.status-dot { display: inline-block; width: .48rem; height: .48rem; margin-right: .45rem; background: var(--accent); border-radius: 50%; }
.workflow { padding: 2.4rem; display: grid; justify-items: center; }
.workflow-node { width: 100%; padding: .85rem; border: 1px solid rgba(184,255,108,.45); background: rgba(8, 30, 18, .85); border-radius: .35rem; color: #e7f9e8; font-size: .88rem; text-align: center; }
.start-node { width: 65%; border-color: var(--orange); }
.outcome-node { width: 78%; background: var(--accent); color: #112514; font-weight: 800; }
.outcome-node span { float: right; }
.workflow-line { width: 1px; height: 2rem; background: linear-gradient(var(--orange), var(--accent)); }
.workflow-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; width: 100%; }
.trust { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.trust div { padding: 1.55rem 1rem; border-right: 1px solid var(--line); }
.trust div:first-child { padding-left: 0; }
.trust div:last-child { border: 0; }
.trust strong { display: block; color: var(--accent); font-family: var(--display); font-size: 2rem; font-weight: 400; }
.trust span { color: var(--muted); font-size: .86rem; }
.split-section { display: grid; grid-template-columns: .8fr 1.2fr; column-gap: 6rem; row-gap: 2rem; padding: 8rem 0; }
.section-copy { color: var(--muted); max-width: 530px; }
.path-selector { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; align-self: end; }
.path-card { position: relative; min-height: 148px; border: 1px solid var(--line); border-radius: .4rem; padding: 1rem; background: transparent; color: var(--ink); text-align: left; cursor: pointer; }
.path-card:hover, .path-card:focus-visible, .path-card.is-selected { background: var(--card); border-color: var(--accent); }
.path-card span { display: block; color: var(--accent); font: .72rem ui-monospace, monospace; }
.path-card strong { display: block; margin: .8rem 0 .3rem; }
.path-card small { color: var(--muted); font-size: .78rem; }
.path-detail { grid-column: 2; min-height: 72px; border-left: 2px solid var(--accent); padding: .2rem 0 .2rem 1rem; color: var(--muted); }
.path-detail strong { color: var(--ink); }
.quickstart { display: grid; grid-template-columns: .75fr 1.25fr; gap: 3rem; align-items: center; padding: 3.2rem; border-radius: .8rem; background: #102d1d; }
.quickstart h2 { font-size: clamp(2rem, 3vw, 3rem); }
.quickstart p:not(.eyebrow) { color: var(--muted); }
.code-card { border: 1px solid var(--line); border-radius: .45rem; overflow: hidden; background: #06120d; }
.code-card-header { display: flex; justify-content: space-between; padding: .7rem .9rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .75rem; }
.copy-button { border: 0; color: var(--accent); background: transparent; cursor: pointer; font-weight: 700; }
pre { padding: 1.2rem; margin: 0; white-space: pre-wrap; color: #dfffd1; font-size: .8rem; }
#catalog { padding: 8rem 0; }
.section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2.4rem; }
.module-grid { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--line); }
.module-card { min-height: 214px; padding: 1.6rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(13, 37, 25, .25); transition: background .18s ease, transform .18s ease; }
.module-card:nth-child(even) { border-right: 0; }
.module-card:nth-last-child(-n+2) { border-bottom: 0; }
.module-card:hover { background: var(--card); transform: translateY(-3px); }
.module-meta { display: flex; justify-content: space-between; color: var(--accent); font: .72rem ui-monospace, monospace; }
.module-card h3 { margin: 2.1rem 0 .45rem; font-family: var(--display); font-weight: 400; font-size: 1.55rem; letter-spacing: -.03em; }
.module-card p { margin: 0; color: var(--muted); font-size: .9rem; }
.module-link { display: inline-block; margin-top: 1rem; color: var(--accent); font-size: .84rem; font-weight: 700; text-decoration: none; }
.practice-section { display: grid; grid-template-columns: .75fr 1.25fr; gap: 4.5rem; padding: 5rem 0; border-top: 1px solid var(--line); }
.assessment { display: grid; gap: 1rem; }
fieldset { border: 1px solid var(--line); border-radius: .4rem; padding: 1rem; }
legend { padding: 0 .3rem; color: var(--ink); font-weight: 700; font-size: .92rem; }
label { display: inline-flex; gap: .4rem; margin: .5rem 1rem .1rem 0; color: var(--muted); font-size: .88rem; }
input { accent-color: var(--accent); }
.assessment .button { justify-self: start; }
.assessment-result { min-height: 1.5rem; margin: 0; color: var(--accent); font-weight: 700; }
.callout { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin: 4rem auto 5rem; padding: 3.5rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.site-footer { display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: center; width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; padding: 2.2rem 0 3rem; color: var(--muted); font-size: .76rem; }
.site-footer p { margin: 0; }
.footer-brand { color: var(--ink); }

@media (max-width: 780px) {
  .site-header { width: min(100% - 1.4rem, 1180px); }
  .menu-toggle { display: block; }
  .site-nav { position: absolute; display: none; top: 100%; right: 0; left: 0; flex-direction: column; align-items: stretch; padding: 1rem; border: 1px solid var(--line); background: #0b1d14; }
  .site-nav.is-open { display: flex; }
  .site-nav a { padding: .6rem; }
  .section-shell { width: min(100% - 1.4rem, 1180px); }
  .hero, .split-section, .quickstart, .practice-section { grid-template-columns: 1fr; gap: 2.3rem; }
  .hero { min-height: 0; padding: 3.5rem 0; }
  .path-detail { grid-column: auto; }
  .path-selector { grid-template-columns: 1fr; }
  .path-card { min-height: 0; }
  .section-heading, .callout { align-items: start; flex-direction: column; }
  .module-grid { grid-template-columns: 1fr; }
  .module-card, .module-card:nth-child(even), .module-card:nth-last-child(-n+2) { border-right: 0; border-bottom: 1px solid var(--line); }
  .module-card:last-child { border-bottom: 0; }
  .site-footer { grid-template-columns: 1fr; gap: 1rem; }
}
@media (max-width: 500px) {
  .trust { grid-template-columns: 1fr; }
  .trust div, .trust div:first-child { padding: 1rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
  .trust div:last-child { border-bottom: 0; }
  .quickstart { padding: 1.5rem; }
  .workflow { padding: 1.3rem; }
}
