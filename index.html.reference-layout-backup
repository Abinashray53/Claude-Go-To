<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Claude Go-To is a practical, visual learning hub for reliable AI-assisted development workflows." />
    <meta name="theme-color" content="#0c1713" />
    <meta property="og:title" content="Claude Go-To — Practical AI development workflows" />
    <meta property="og:description" content="A visual learning hub for prompts, project context, reusable skills, agents, and quality checks." />
    <meta property="og:type" content="website" />
    <title>Claude Go-To | Build better AI workflows</title>
    <link rel="icon" href="assets/compass-mark.svg" type="image/svg+xml" />
    <link rel="manifest" href="site.webmanifest" />
